# 카톡 비서 설정. settings.env 로 복사해서 고친다. run.sh 와 setup/schedule.sh 가 읽는다.

# 요약과 초안에서 나를 부를 이름
OWNER_NAME="사용자"

# 대시보드(카톡비서.html), 요약, TASKS.md, 받은 파일이 쌓이는 폴더
OUT_DIR="$HOME/Documents/카톡비서"

# 근무시간: 평일 이 시각부터 이 시각까지 매시 정각에 돈다
WORK_START=9
WORK_END=19

# 요약에 쓸 Claude 모델 (sonnet 권장, 더 아끼려면 haiku)
CLAUDE_MODEL=sonnet

# kakao-mcp 를 받은 곳 (install.sh 기본값과 같게 둔다)
KAKAO_MCP_DIR="$HOME/code/kakao-mcp"
