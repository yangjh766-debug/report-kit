{
  "model": "opus",
  "language": "korean",
  "effortLevel": "high",
  "agentPushNotifEnabled": true,
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(ls *)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git push --force *)"
    ]
  },
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "osascript -e 'display notification \"Claude가 확인을 기다립니다\" with title \"Claude Code\" sound name \"Glass\"'"
          }
        ]
      }
    ]
  }
}